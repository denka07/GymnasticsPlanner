# Copy this file to .env.local and fill in the values.

# Postgres connection string for the Neon database.
DATABASE_URL=

# Neon Auth URL for the database branch (Neon Console: Auth > Configuration).
# Not secret.
NEON_AUTH_BASE_URL=

# Secret used to sign the session cookies, at least 32 characters.
# Generate one with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
