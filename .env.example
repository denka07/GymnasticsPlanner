# Copy this file to .env.local and fill in the values.

# Postgres connection string for the Neon database.
DATABASE_URL=

# Neon Auth URL for the database branch (Neon Console: Auth > Configuration).
# Not secret.
NEON_AUTH_BASE_URL=

# Secret used to sign the session cookies, at least 32 characters.
# Generate one with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Development-only sign-in without Google. Only works under `next dev`
# (NODE_ENV=development); production builds and tests ignore it.
# WARNING: anyone who can reach the dev server is signed in as this user.
# The header then offers a switcher to the test users helper@example.test and
# newcomer@example.test (cookie dev_user), for trying sharing with two accounts.
# DEV_SIGN_IN_EMAIL=dev@example.test
